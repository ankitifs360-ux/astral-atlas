{
  "name": "astral-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @astral-atlas/shared typecheck && pnpm --filter @astral-atlas/database typecheck && pnpm --filter @astral-atlas/api typecheck && pnpm --filter @astral-atlas/worker typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:check": "tsx scripts/validate-env.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "api:dev": "pnpm --filter @astral-atlas/api dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
