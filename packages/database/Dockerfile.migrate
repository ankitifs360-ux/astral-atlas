# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22.23.3
ARG PNPM_VERSION=12.14.0

FROM node:${NODE_VERSION}-bookworm-slim AS migration

ARG PNPM_VERSION

ENV NODE_ENV=production
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"

WORKDIR /app

RUN corepack enable \
  && corepack prepare "pnpm@${PNPM_VERSION}" --activate

# Install only the root tooling needed for drizzle-kit plus
# the database workspace and its runtime dependencies.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/database/package.json ./packages/database/package.json

RUN pnpm install \
  --frozen-lockfile \
  --filter astral-atlas \
  --filter @astral-atlas/database

# drizzle.config.ts loads the TypeScript schema directly.
COPY drizzle.config.ts ./
COPY packages/database/src ./packages/database/src

# drizzle-kit migrate consumes committed SQL migration files
# and their metadata from this directory.
COPY packages/database/drizzle ./packages/database/drizzle

CMD ["pnpm", "db:migrate"]